# Settings for the Docker setup (docker-compose.yml). `make up` copies this
# file to .env if there isn't one; edit .env, never this file.
# .env is gitignored: it may hold your SMTP password.

# Where the site runs:
#   empty                 your own computer: http://localhost:8735, no HTTPS
#   academy.example.com   a server (no https://): the public site at
#                         https://academy.example.com. Caddy gets the HTTPS
#                         certificate as soon as the domain's DNS A/AAAA
#                         record points at the server.
# Run `make up` after changing it.
DOMAIN=

# Who serves HTTPS on a server:
#   caddy     (the default) the caddy container: it takes ports 80 and 443 and
#             gets the certificate by itself
#   external  the server already runs a web server (nginx, Apache...) on 80/443
#             for other sites. Only the app is started, on 127.0.0.1:8735, and
#             that web server must forward to it (DEPLOYMENT.md §3 has an nginx
#             example).
PROXY=caddy

# Where the lesson videos are on this machine (README.md → "Lesson videos").
# Empty: the media/ folder here.
MEDIA_DIR=

# Outbound email: student invitations and password resets. While these stay
# commented out, the admin panel shows the links for you to send yourself.
# The mail server's certificate must be valid (it is checked). Check with:
# make email-test TO=you@example.com
#
# Recommended, with no password anywhere: the mail administrator allows this
# server's IP address to send as the address below (an "SMTP relay").
#ACADEMY_SMTP_HOST=mail.mil.am
#ACADEMY_SMTP_PORT=25
#ACADEMY_SMTP_FROM="1991 Academy <ai.1991@mil.am>"
#
# Only if the mail server insists on a login: a mailbox made just for the
# site (never the support inbox), port 587, and its password in single quotes.
#ACADEMY_SMTP_USER=
#ACADEMY_SMTP_PASS=
