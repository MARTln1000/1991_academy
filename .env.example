# Local configuration for the Docker setup. `make up` copies this file to .env.

# Public hostname (without scheme). Empty: run locally on http://localhost:8735.
# Set to e.g. academy.example.com on a server; Caddy then obtains a TLS
# certificate once DNS points at the host.
DOMAIN=

# TLS termination:
#   caddy     the bundled Caddy container binds ports 80/443 (default)
#   external  an existing web server proxies to 127.0.0.1:8735
#             (see docs/deployment.md for an nginx example)
PROXY=caddy

# Directory with self-hosted lesson videos. Empty: ./media
MEDIA_DIR=
