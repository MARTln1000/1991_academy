# Build context exclusions. The image needs app.py, the page files and the
# css/ js/ tracks/ assets/ trees.

# Data, secrets and local environments
**/*.db
**/*.db-wal
**/*.db-shm
.env
.env.*
backups/
media/
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
tests/

# Repository metadata and tooling
.git/
.gitignore
.github/
.*
**/.DS_Store
.dockerignore
Dockerfile
docker-compose*.yml
Makefile
pyproject.toml
*.md
docs/
requirements-dev.txt
tools/

# deploy/: only the backup script runs inside the container
deploy/
!deploy/backup.sh
