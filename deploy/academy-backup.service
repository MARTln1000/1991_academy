# Consistent, compressed snapshot of the database into /var/backups/academy.
# Started nightly by academy-backup.timer and by deploy/activate.sh right
# before every deploy. Run one by hand with:  sudo systemctl start academy-backup
[Unit]
Description=Back up the 1991 Academy database

[Service]
Type=oneshot
User=academy
Group=academy
# Same database path the app uses; academy.env overrides the default.
Environment=ACADEMY_DB=/var/lib/academy/academy.db
EnvironmentFile=/etc/academy/academy.env
ExecStart=/usr/local/sbin/academy-backup

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# sqlite may need to touch the -wal/-shm files next to the database
ReadWritePaths=/var/lib/academy /var/backups/academy
