# /etc/academy/academy.env holds site-specific settings and secrets for 1991 Academy.
# deploy/setup-server.sh creates it from this template and never overwrites it.
#
# academy.service reads this file after its own production defaults
# (ACADEMY_HOST=127.0.0.1, PORT=8735, ACADEMY_DB=/var/lib/academy/academy.db,
# ACADEMY_DEBUG=0, ACADEMY_CPP=0, ACADEMY_TRUST_PROXY=1), so a value set here
# overrides them. DEPLOYMENT.md documents every variable.
#
# Apply changes with:  sudo systemctl restart academy

# Public origin, used to build the links in password-reset emails.
ACADEMY_BASE_URL=https://academy.example.com

# Outbound email for password resets (STARTTLS). While these stay commented
# out, reset links are written to the log (journalctl -u academy) instead.
#ACADEMY_SMTP_HOST=smtp.example.com
#ACADEMY_SMTP_PORT=587
#ACADEMY_SMTP_USER=
#ACADEMY_SMTP_PASS=
#ACADEMY_SMTP_FROM=
