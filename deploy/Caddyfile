# Caddy reverse proxy. TLS certificates are obtained and renewed automatically
# for $DOMAIN. Caddy overwrites X-Forwarded-For, which the app relies on
# (ACADEMY_TRUST_PROXY=1).
{$DOMAIN} {
	header {
		-Server
		-Via
	}
	# Internal only; reached directly on :8735 by health checks and `make status`.
	handle /api/health {
		respond 404
	}
	# Self-hosted media, served from disk to authenticated users only
	# (forward_auth). Only valid media file names; no directory listings.
	handle_path /media/* {
		forward_auth app:8735 {
			uri /api/auth-check
		}
		@other not path_regexp ^/[A-Za-z0-9_-]{1,64}\.(mp4|webm|jpg|vtt)$
		respond @other 404
		header {
			Cache-Control "private, max-age=86400"
			X-Content-Type-Options nosniff
			X-Robots-Tag "noindex, nofollow"
		}
		root * /srv/media
		file_server
	}
	handle {
		reverse_proxy app:8735 {
			# Retry while the app restarts during deploys instead of returning 502.
			lb_try_duration 20s
			lb_try_interval 250ms
		}
	}
}
