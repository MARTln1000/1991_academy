# The caddy service in docker-compose.yml mounts this as /etc/caddy/Caddyfile.
#
# DOMAIN comes from .env. Caddy gets and renews the HTTPS certificate on its
# own once DNS points at this server, and redirects http:// to https://. It
# also sets X-Forwarded-For to the real client address and drops any value the
# client sent, which is what makes ACADEMY_TRUST_PROXY=1 on the app safe.
{$DOMAIN} {
	# Don't tell scanners which server software answers.
	header {
		-Server
		-Via
	}
	# /api/health reports the deployed commit and config flags. `make status`,
	# CI and the container healthcheck reach the app directly on port 8735;
	# the internet doesn't need it.
	respond /api/health 404
	reverse_proxy app:8735 {
		# While the app restarts during an update (a few seconds), hold each
		# request and retry, so visitors see a short pause instead of a 502.
		# Only requests that never reached the app are retried.
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}
