# 1991 Academy. Installed to /etc/systemd/system/ by deploy/setup-server.sh.
#
# Runs whichever release /opt/academy/current points at. deploy/activate.sh
# stops the service, repoints the symlink and starts it again, so a running
# process never sees the symlink change underneath it.
[Unit]
Description=1991 Academy
After=network.target
# Never give up restarting: the deploy health check, not a start-rate limit,
# decides whether a release is good (a tripped limit would also make the
# automatic rollback's `systemctl start` fail).
StartLimitIntervalSec=0

[Service]
Type=exec
User=academy
Group=academy
WorkingDirectory=/opt/academy/current
ExecStart=/opt/academy/current/.venv/bin/python app.py

# Production defaults. /etc/academy/academy.env (domain, SMTP credentials) is
# read after these, so anything set there wins. Keep ACADEMY_DEBUG and
# ACADEMY_CPP at 0 on a public server; DEPLOYMENT.md explains each one.
Environment=ACADEMY_HOST=127.0.0.1 PORT=8735 ACADEMY_DB=/var/lib/academy/academy.db
Environment=ACADEMY_DEBUG=0 ACADEMY_CPP=0 ACADEMY_TRUST_PROXY=1
EnvironmentFile=/etc/academy/academy.env

# /var/lib/academy: created by systemd, owned by and private to `academy`.
StateDirectory=academy
StateDirectoryMode=0700

Restart=on-failure
RestartSec=2
TimeoutStopSec=20

# Sandbox: the app can write its database directory and nothing else, not
# even its own code, and holds no capabilities (port 8735 needs none).
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
